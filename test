-- ================= NEW SUFFIX SYSTEM =================

-- Map superscript digits (⁰¹²³⁴⁵⁶⁷⁸⁹) to numbers
local superscriptMap = {
    ['⁰']=0, ['¹']=1, ['²']=2, ['³']=3, ['⁴']=4,
    ['⁵']=5, ['⁶']=6, ['⁷']=7, ['⁸']=8, ['⁹']=9
}

local function parseSuperscript(str)
    local num = 0
    for i = 1, #str do
        local ch = str:sub(i,i)
        local digit = superscriptMap[ch]
        if digit then num = num * 10 + digit end
    end
    return num
end

-- Convert a suffix string (e.g., "K", "d⁵", "ddddd") to exponent
function getSuffixExponent(suffix)
    if suffix == nil or suffix == "" then return 0 end
    local common = { K=3, M=6, B=9, T=12, q=15, Q=18 }
    if common[suffix] then return common[suffix] end

    -- Extract base letter (first character)
    local letter = suffix:sub(1,1):lower()
    local letterIdx = string.byte(letter) - 96
    if letterIdx < 1 or letterIdx > 26 then return 0 end

    -- Determine repeat count (superscript or length)
    local repeatCount = 1
    local rest = suffix:sub(2)
    if rest ~= "" then
        local sup = parseSuperscript(rest)
        if sup > 0 then
            repeatCount = sup
        else
            repeatCount = 1 + #rest   -- fallback for "ddddd"
        end
    end

    -- Exponent formula:
    -- Base exponent for 'a' with repeat=1 is 21
    -- Each letter adds 3, each extra repeat adds 3
    local baseExp = 21 + (letterIdx - 1) * 3
    return baseExp + (repeatCount - 1) * 3
end

-- Parse a money string like "18.63d⁵" -> raw number
function parseMoneyString(val)
    if type(val) == "number" then return val end
    if type(val) ~= "string" then return 0 end

    local numStr, suffix = val:match("([%d%.]+)(.*)")
    if not numStr then return 0 end
    local number = tonumber(numStr) or 0
    suffix = suffix:gsub("%s+", "")
    local exponent = getSuffixExponent(suffix)
    return number * (10 ^ exponent)
end

-- Format raw number to compact superscript string
function formatValueToSuffix(value)
    if value == 0 then return "0" end
    if value < 1000 then return string.format("%.2f", value) end

    local exponent = math.floor(math.log10(value))
    local tier = math.floor(exponent / 3)

    local commonSuffixes = {"", "K", "M", "B", "T", "q", "Q"}
    if tier <= #commonSuffixes - 1 then
        local divisor = 10 ^ (tier * 3)
        local displayNum = value / divisor
        return string.format("%.2f%s", displayNum, commonSuffixes[tier+1])
    end

    -- Custom letter + superscript
    local remainingTier = tier - (#commonSuffixes - 1)  -- tier 0 = after Q
    local repeatCount = math.floor(remainingTier / 26) + 5   -- starts at 5
    local letterIndex = (remainingTier % 26) + 1
    local letter = string.char(96 + letterIndex)  -- a=1

    -- Build superscript digits
    local supDigits = ""
    local n = repeatCount
    while n > 0 do
        local digit = n % 10
        local supChar = string.char(0x2070 + digit)
        supDigits = supChar .. supDigits
        n = math.floor(n / 10)
    end
    local suffix = letter .. supDigits

    local divisor = 10 ^ (tier * 3)
    local displayNum = value / divisor
    return string.format("%.2f%s", displayNum, suffix)
end

-- Generate suffix by index (for the up/down arrows)
-- Index 1: "", 2:"K", 3:"M", 4:"B", 5:"T", 6:"q", 7:"Q"
-- Index 8: "a⁵", 9:"b⁵", ... 33:"z⁵", 34:"a⁶", 35:"b⁶", ...
function generateSuffix(index)
    local common = {"", "K", "M", "B", "T", "q", "Q"}
    if index <= #common then
        return common[index]
    end

    local customIndex = index - #common  -- 1-based
    local repeatCount = math.floor((customIndex - 1) / 26) + 5   -- starts at 5
    local letterIndex = ((customIndex - 1) % 26) + 1
    local letter = string.char(96 + letterIndex)

    -- Convert repeatCount to superscript digits
    local supDigits = ""
    local n = repeatCount
    while n > 0 do
        local digit = n % 10
        local supChar = string.char(0x2070 + digit)
        supDigits = supChar .. supDigits
        n = math.floor(n / 10)
    end
    return letter .. supDigits
end

-- Total number of suffixes (common 7 + 26 per repeat, up to repeat 10)
function getTotalSuffixes()
    local maxRepeat = 10  -- enough for huge numbers
    return 7 + 26 * (maxRepeat - 4)  -- from repeat 5 to maxRepeat
end

-- ================= CORE LOGIC =================

function calculateN(number, suffix)
    local baseNumber = tonumber(number)
    if not baseNumber or baseNumber <= 0 then
        return "Error: Amount must be > 0"
    end
    local exponent = getSuffixExponent(suffix)
    local actualValue = baseNumber * (10 ^ exponent)
    local n = actualValue / 40
    return math.floor(n + 0.5)
end

function getScriptValue(num)
    if num > 10^15 then
        local sciNotation = string.format("%.2e", num)
        local base, exponentStr = sciNotation:match("([%d%.]+)e([%d%-]+)")
        if base and exponentStr then
            local exponent = tonumber(exponentStr)
            if exponent >= 0 then return base .. "e+" .. exponentStr
            else return base .. "e-" .. math.abs(exponent) end
        end
    end
    return tostring(num)
end

